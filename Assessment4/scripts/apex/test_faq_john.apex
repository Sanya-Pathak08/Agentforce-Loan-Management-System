Customer__c cust = [SELECT Id, Max_Loan_Amount__c, Preferred_Loan_Type__c FROM Customer__c WHERE Name = 'John Doe' LIMIT 1]; cust.Preferred_Loan_Type__c = 'Home Loan'; cust.Max_Loan_Amount__c = 5000000; update cust; Map<String, Object> inputs = new Map<String, Object>{'customerId' => 'John Doe', 'preferredLoanType' => 'Home Loan'}; Flow.Interview.Get_Loan_FAQ_Answer flowInterview = new Flow.Interview.Get_Loan_FAQ_Answer(inputs); flowInterview.start(); String ans = (String) flowInterview.getVariableValue('faqAnswer'); System.debug('=== JOHN DOE HOME LOAN FAQ ===: ' + ans);