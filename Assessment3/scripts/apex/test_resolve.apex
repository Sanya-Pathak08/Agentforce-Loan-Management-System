String searchTerm = 'Rajesh'; String termLike = '%' + searchTerm + '%'; List<Loan_Account__c> accs = [SELECT Id, Name, Loan_Number__c, Customer__r.Name, Default_Risk__c, Total_Overdue_Amount__c FROM Loan_Account__c WHERE Customer__r.Name LIKE :termLike OR Loan_Number__c = :searchTerm OR Name = :searchTerm LIMIT 1]; if (!accs.isEmpty()) { System.debug('FOUND: ' + accs[0].Id + ' | ' + accs[0].Customer__r.Name); } else { System.debug('NOT FOUND'); }