Map<String, Object> params = new Map<String, Object>{'loanAccountId' => 'Rajesh'}; Flow.Interview.Send_Loan_Hardship_Message interview = new Flow.Interview.Send_Loan_Hardship_Message(params); try { interview.start(); System.debug('Result: ' + interview.getVariableValue('hardshipMessage')); } catch (Exception e) { System.debug('ERROR: ' + e.getMessage() + ' | ' + e.getStackTraceString()); }