// 1. Home Loan Eligibility Guide
Loan_Document__c docHome = new Loan_Document__c(
    Name = 'Home Loan Eligibility Guide',
    Document_Type__c = 'Home Loan Eligibility Guide'
);
insert docHome;

ContentVersion cvHome = new ContentVersion(
    Title = 'Home Loan Eligibility Guide',
    PathOnClient = 'Home_Loan_Eligibility_Guide.pdf',
    VersionData = EncodingUtil.base64Decode(''),
    IsMajorVersion = true
);
insert cvHome;

Id conDocIdHome = [SELECT ContentDocumentId FROM ContentVersion WHERE Id = :cvHome.Id].ContentDocumentId;
insert new ContentDocumentLink(
    LinkedEntityId = docHome.Id,
    ContentDocumentId = conDocIdHome,
    ShareType = 'V',
    Visibility = 'AllUsers'
);
System.debug('Uploaded Home Loan Eligibility Guide: ' + conDocIdHome);

