// 1. Create Loan_Document__c record
Loan_Document__c doc = new Loan_Document__c(
    Name = 'Personal Loan Policy',
    Document_Type__c = 'Personal Loan Policy'
);
insert doc;
System.debug('Created Loan_Document__c Id: ' + doc.Id);

// 2. Create ContentVersion
ContentVersion cv = new ContentVersion(
    Title = 'Personal Loan Policy',
    PathOnClient = 'Personal_Loan_Policy.pdf',
    VersionData = EncodingUtil.base64Decode(''),
    IsMajorVersion = true
);
insert cv;

Id conDocId = [SELECT ContentDocumentId FROM ContentVersion WHERE Id = :cv.Id].ContentDocumentId;
System.debug('Created ContentDocumentId: ' + conDocId);

// 3. Link ContentDocument to Loan_Document__c
ContentDocumentLink cdl = new ContentDocumentLink(
    LinkedEntityId = doc.Id,
    ContentDocumentId = conDocId,
    ShareType = 'V',
    Visibility = 'AllUsers'
);
insert cdl;
System.debug('Created ContentDocumentLink successfully!');
